# =============================================================================
# ServiceNow Resolution Agent - settings template
#
#   1. Copy this file and name the copy .env   (copy .env.example .env)
#   2. Fill in the REQUIRED section.
#   3. Leave everything else blank to use the default shown in its comment.
#
# .env holds passwords and keys. It is listed in .gitignore - never commit it.
# =============================================================================


# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Your instance address, nothing after .com
# e.g. https://dev123456.service-now.com
SERVICENOW_INSTANCE_URL=

# The agent's own restricted account (reads tickets, adds work notes only).
# Created and filled in automatically by: python scripts/create_agent_user.py
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# TCS GenAI Lab MaaS key, issued during the AI Fridays event
TCS_GENAI_API_KEY=


# ---------------------------------------------------------------------------
# ADMIN LOGIN - only for the setup scripts, never used by the agent
# Fill in to run scripts/seed_demo_data.py or scripts/create_agent_user.py,
# then blank the password again. developer.servicenow.com -> Manage instance
# -> Manage instance password.
# ---------------------------------------------------------------------------
SN_SEED_USERNAME=
SN_SEED_PASSWORD=


# ---------------------------------------------------------------------------
# OPTIONAL - ServiceNow connection
# ---------------------------------------------------------------------------

# basic or oauth (default: basic). oauth also needs the two lines below.
SERVICENOW_AUTH_MODE=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# Seconds to wait for a response (default: 30)
SERVICENOW_TIMEOUT_S=
# Minimum seconds between requests, to be gentle on the instance (default: 0.05)
SERVICENOW_MIN_REQUEST_INTERVAL_S=
# Retries after a network error or a 5xx/429 response (default: 4)
SERVICENOW_MAX_RETRIES=
# Records fetched per request, and the most pages read per query (defaults: 100, 100)
SERVICENOW_PAGE_SIZE=
SERVICENOW_MAX_PAGES=


# ---------------------------------------------------------------------------
# OPTIONAL - TCS GenAI Lab gateway
# Only models served from this gateway may be used (AI Fridays handbook,
# section 13.10.18). See section 13.5 for the current model list.
# ---------------------------------------------------------------------------

# Gateway base URL (default: https://genailab.tcs.in)
TCS_GENAI_BASE_URL=
# Verify the gateway's certificate against the Windows cert store
# (default: true). Set false only if your machine lacks the corporate CA.
TCS_GENAI_VERIFY_SSL=

# Cheap model: reading, planning, grading (default: azure/genailab-maas-gpt-4o-mini)
MODEL_LITE=
# Drafting and fact-checking (default: azure/genailab-maas-gpt-4o)
MODEL_FLASH=
# Used when a first attempt scores low
# (default: azure_ai/genailab-maas-Llama-4-Maverick-17B-128E-Instruct-FP8)
MODEL_PRO=
# Retries when a model is overloaded, before falling back (default: 3)
LLM_MAX_RETRIES=


# ---------------------------------------------------------------------------
# OPTIONAL - how the agent works through tickets
# ---------------------------------------------------------------------------

# Tickets researched at the same time (default: 3)
WORKER_THREADS=
# Look for new tickets automatically when running `serve` (default: true)
SWEEP_ENABLED=
# Minutes between looks for new tickets (default: 1)
SWEEP_INTERVAL_MINUTES=
# Only tickets opened in the last N days, so a backlog can't run up a bill (default: 3)
SWEEP_WINDOW_DAYS=
# Most tickets queued per look (default: 50)
SWEEP_MAX_TICKETS=
# Give up on a ticket after this many failures, until restarted (default: 3)
MAX_FAILURES_PER_TICKET=


# ---------------------------------------------------------------------------
# OPTIONAL - searching past tickets
# ---------------------------------------------------------------------------

# Results kept from each full-text search (default: 10)
SEARCH_RESULTS_PER_QUERY=
# Results kept from each same-system / same-category sweep (default: 15)
SEARCH_SWEEP_LIMIT=
# Most past tickets sent to grading per research pass (default: 12)
MAX_CANDIDATE_TICKETS=
# Longest piece of ticket text per citation (default: 1500)
CHUNK_MAX_CHARS=
# How far back to search resolved tickets, in days (default: 1095, about 3 years)
SEARCH_RECENCY_DAYS=


# ---------------------------------------------------------------------------
# OPTIONAL - open duplicates and major incidents
# ---------------------------------------------------------------------------

# How far back to look for open duplicates, in days (default: 14)
OPEN_TICKET_WINDOW_DAYS=
# Search queries used to find open duplicates (default: 2)
OPEN_TICKET_QUERIES=
# Most open duplicates listed in a note (default: 5)
OPEN_TICKET_MAX_CANDIDATES=
# Warn of a major incident at this many tickets, counting this one (default: 3)
MAJOR_INCIDENT_MIN_TICKETS=
# ...opened within this many hours (default: 24)
MAJOR_INCIDENT_WINDOW_HOURS=


# ---------------------------------------------------------------------------
# OPTIONAL - research loop, budget and confidence
# ---------------------------------------------------------------------------

# Research passes before giving up on a low score (default: 3)
MAX_ITERATIONS=
# Spending cap per ticket, in US dollars (default: 0.25)
MAX_COST_USD_PER_TICKET=
# Token cap per ticket (default: 400000)
MAX_TOKENS_PER_TICKET=
# Score at or above this is "high" (default: 75)
CONFIDENCE_HIGH=
# Score at or above this is "medium"; below is "low" (default: 50)
CONFIDENCE_MEDIUM=
# Never "high" if less than this share of claims is backed by its source (default: 0.5)
MIN_SUPPORT_RATE_FOR_HIGH=
# Extra drafts to test consistency when the score is borderline (default: 2)
AGREEMENT_SAMPLES=
# How far below "high" counts as borderline (default: 10)
AGREEMENT_BAND=
# JSON file of custom confidence weights (default: none, built-in weights)
CONFIDENCE_WEIGHTS_FILE=
# JSON of model prices per 1M tokens, e.g. {"model-name": [0.25, 1.5]} (default: built-in)
PRICES_JSON=


# ---------------------------------------------------------------------------
# OPTIONAL - intake agent (the voice/text chatbot that answers before a ticket)
# ---------------------------------------------------------------------------

# Its own ServiceNow account, allowed to create incidents and add notes.
# Created by: python scripts/create_agent_user.py --intake
SN_INTAKE_USERNAME=
SN_INTAKE_PASSWORD=
# true to really create incidents (default: false - it only drafts them and logs
# the payload). Leave false until a dry run looks right.
INTAKE_CREATE_TICKETS=
# Team that gets a ticket when no team stands out (default: Service Desk)
INTAKE_DEFAULT_GROUP=
# Tag on every incident it raises, for cleanup (default: sn-intake-agent)
INTAKE_CORRELATION_ID=
# Display name(s) of the ticket agent's ServiceNow account, comma separated.
# Their work notes are never used as evidence of a fix (default: none; notes
# carrying the agent's [AI Resolution Assistant] header are always skipped)
INTAKE_AGENT_NOTE_AUTHORS=
# Most past tickets graded per search while the user waits (default: 8)
INTAKE_MAX_CANDIDATES=
# ServiceNow queries run at once during a search (default: 4)
INTAKE_SEARCH_THREADS=
# Model for conversation turns (default: MODEL_LITE). Fix steps are written by
# MODEL_FLASH, like the ticket agent's drafts.
INTAKE_CHAT_MODEL=


# ---------------------------------------------------------------------------
# OPTIONAL - web app (chatbot page + ops console)
# ---------------------------------------------------------------------------

# Where logins, conversations and agent run history are kept (default: data/sn_agent.db)
APP_DB_PATH=
# Long random string that signs login cookies. Set it, or every restart logs everyone out.
APP_SECRET_KEY=
# Record each ticket-agent run's steps for the ops console (default: true)
RECORD_AGENT_RUNS=


# ---------------------------------------------------------------------------
# OPTIONAL - LiveKit (voice). Defaults match `livekit-server --dev` on this machine.
# ---------------------------------------------------------------------------

# Address the voice worker connects to (default: ws://127.0.0.1:7880)
LIVEKIT_URL=
# Address browsers connect to, if different (default: same as LIVEKIT_URL)
LIVEKIT_PUBLIC_URL=
# (defaults: devkey / secret, the dev server's built-in pair)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ---------------------------------------------------------------------------
# OPTIONAL - local speech models (free, run on this machine, no external API)
# ---------------------------------------------------------------------------

# faster-whisper model: base.en (fastest), distil-small.en, small.en (most
# accurate on CPU). Run scripts/download_voice_models.py after changing it.
# (default: distil-small.en)
STT_MODEL=
# local (faster-whisper on this machine) or gateway (the TCS GenAI Lab whisper:
# more accurate, adds a network round trip per phrase). (default: local)
STT_PROVIDER=
# Whisper model on the gateway (default: azure/genailab-maas-whisper)
STT_GATEWAY_MODEL=
# auto, cpu or cuda (default: auto)
STT_DEVICE=
# (default: en)
STT_LANGUAGE=
# Kokoro model files, downloaded by: python scripts/download_voice_models.py
# (defaults: models/kokoro-v1.0.int8.onnx and models/voices-v1.0.bin)
TTS_MODEL_PATH=
TTS_VOICES_PATH=
# Kokoro voice (default: af_heart) and speed (default: 1.05)
TTS_VOICE=
TTS_SPEED=


# ---------------------------------------------------------------------------
# OPTIONAL - webhook (off: no open port; see servicenow/SETUP.md first)
# ---------------------------------------------------------------------------

# true to let ServiceNow notify the agent instantly (default: false)
WEBHOOK_ENABLED=
# Long random secret shared with the ServiceNow Business Rule
WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# OPTIONAL - logging
# ---------------------------------------------------------------------------

# DEBUG, INFO, WARNING or ERROR (default: INFO). Or run any command with -v.
LOG_LEVEL=
# none, console or otlp (default: none)
OTEL_EXPORTER=
